{
  "name": "lifespan",
  "productName": "Lifespan",
  "version": "1.0.0",
  "description": "A single-player life simulator.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "Lifespan",
  "license": "UNLICENSED",
  "scripts": {
    "dev:web": "vite -c vite.web.config.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build -c vite.web.config.ts --logLevel warn",
    "typecheck": "tsc -p tsconfig.engine.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "hygiene": "tsx scripts/check-hygiene.ts",
    "test": "vitest run",
    "content:check": "tsx scripts/content-check.ts",
    "sim": "tsx scripts/sim.ts",
    "sim:coverage": "tsx scripts/sim-coverage.ts",
    "e2e": "playwright test",
    "electron:smoke": "xvfb-run -a playwright test -c playwright.electron.config.ts",
    "electron:smoke:packaged": "tsx scripts/smoke-packaged.ts",
    "shots": "tsx scripts/shots.ts",
    "dist:mac": "tsx scripts/dist.ts mac",
    "dist:linux": "tsx scripts/dist.ts linux",
    "verify": "tsx scripts/verify.ts",
    "docs:cheats": "tsx scripts/docs-cheats.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
